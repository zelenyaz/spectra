+/* colloid: is this node's local memory congested vs. the remote tier? */
+static bool htmm_node_congested(int nid)
+{
+    unsigned long l, r;
+
+    if (!htmm_cong_demotion)
+	return false;
+    if (nid != READ_ONCE(htmm_cong_nid))
+	return false;
+    l = READ_ONCE(htmm_local_lat);
+    r = READ_ONCE(htmm_remote_lat);
+    if (r == 0)
+	return false;
+    return l > r * (100 + htmm_cong_delta) / 100;
+}
+
+/* colloid: persistent binary-search watermarks for the access-probability
+ * shift (Algorithm 2 of Vuppalapati & Agarwal, "Tiered Memory Management:
+ * Access Latency is the Key!", SOSP'24). Single monitored node. */
+#define COLLOID_FP_SHIFT 10
+#define COLLOID_FP_ONE	 (1UL << COLLOID_FP_SHIFT)
+
+static unsigned long cong_p_lo;			/* low watermark  (fixed-point) */
+static unsigned long cong_p_hi = COLLOID_FP_ONE;/* high watermark (fixed-point) */
+
+/*
+ * colloid: COMPUTESHIFT (Algorithm 2) + page-count translation.
+ *
+ * Runs every demotion quantum (not only when congested) so that *both*
+ * watermarks keep tightening and the binary search brackets the equilibrium
+ * p*; calling it only in the congested branch would leave cong_p_lo pinned at
+ * 0, making dp = p/2 every period and oscillating instead of converging.
+ *
+ * Measures p = R_D/(R_D+R_A), updates the watermark on the side indicated by
+ * the latency ordering, and returns the desired shift |midpoint(p_lo,p_hi) - p|
+ * translated into a hot-page count (shed a dp/p fraction of the local active
+ * set). Returns >0 only in the demote regime (L_D > L_A); in the promote
+ * regime the promotion thread acts, here we just record cong_p_lo.
+ */
+static unsigned long colloid_compute_demote_pages(struct mem_cgroup *memcg,
+	pg_data_t *pgdat)
+{
+    unsigned long ld = READ_ONCE(htmm_local_lat);
+    unsigned long la = READ_ONCE(htmm_remote_lat);
+    unsigned long rd = READ_ONCE(htmm_local_rate);
+    unsigned long ra = READ_ONCE(htmm_remote_rate);
+    unsigned long delta = (unsigned long)htmm_cong_delta;
+    unsigned long eps = (unsigned long)htmm_cong_epsilon * COLLOID_FP_ONE / 100;
+    unsigned long p, mid, dp, gap, nr_active, nr;
+
+    if (ld == 0 || la == 0 || (rd + ra) == 0)
+	return 0;
+
+    /* p: local tier's current share of access probability */
+    p = (rd << COLLOID_FP_SHIFT) / (rd + ra);
+
+    /* Algo 2, line 2: balanced dead-band |L_D - L_A| < delta% * L_D */
+    gap = (ld > la) ? (ld - la) : (la - ld);
+    if (gap * 100 < delta * ld)
+	return 0;
+
+    /* Algo 2, line 4: tighten the watermark on the appropriate side */
+    if (ld < la)
+	cong_p_lo = p;
+    else
+	cong_p_hi = p;
+
+    /* Algo 2, lines 5-6: watermarks collapsed but not balanced -> reset */
+    if (cong_p_hi < cong_p_lo + eps) {
+	if (ld < la)
+	    cong_p_hi = COLLOID_FP_ONE;
+	else
+	    cong_p_lo = 0;
+    }
+
+    /* promote regime: nothing to demote, watermark already recorded above */
+    if (ld < la)
+	return 0;
+
+    /* desired shift toward the midpoint: dp = p - (p_lo + p_hi)/2 */
+    mid = (cong_p_lo + cong_p_hi) >> 1;
+    if (p <= mid)
+	return 0;
+    dp = p - mid;
+
+    /* translate dp into a count of local hot pages (shed dp/p of the set) */
+    nr_active = lruvec_lru_size(mem_cgroup_lruvec(memcg, pgdat),
+			    LRU_ACTIVE_ANON, MAX_NR_ZONES);
+    nr = (nr_active * dp) / p;
+
+    /* static migration rate limit M */
+    if (nr > htmm_cong_max_batch)
+	nr = htmm_cong_max_batch;
+    return nr;
+}
