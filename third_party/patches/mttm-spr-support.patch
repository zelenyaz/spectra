+/*
+ * Sapphire Rapids IMC PMON access goes through MMIO. For each (socket, iMC,
+ * channel) tuple we resolve a physical address from PCICFG (DID 0x3251,
+ * Section 1.10.3 of the SPR Uncore Performance Monitoring Guide) and ioremap
+ * a SPR_IMC_MMIO_SIZE-byte window covering that channel's PMON box.
+ */
+static void __iomem *spr_imc_mmio[NUM_SOCKETS][NUM_IMC_PER_SOCKET][NUM_CH_PER_IMC];
+static struct pci_dev *spr_imc_pdev[NUM_SOCKETS];
+
