+static inline int spr_imc_chan_idx(int imc, int ch)
+{
+    return imc * NUM_CH_PER_IMC + ch;
+}
+
+static void spr_imc_unmap_all(void)
+{
+    int s, i, c;
+    for (s = 0; s < NUM_SOCKETS; s++) {
+        for (i = 0; i < NUM_IMC_PER_SOCKET; i++) {
+            for (c = 0; c < NUM_CH_PER_IMC; c++) {
+                if (spr_imc_mmio[s][i][c]) {
+                    iounmap(spr_imc_mmio[s][i][c]);
+                    spr_imc_mmio[s][i][c] = NULL;
+                }
+            }
+        }
+        if (spr_imc_pdev[s]) {
+            pci_dev_put(spr_imc_pdev[s]);
+            spr_imc_pdev[s] = NULL;
+        }
+    }
+}
+
+/*
+ * Resolve and ioremap every (iMC, channel) PMON box for every socket.
+ * Each socket has a single PCI function (VID 0x8086, DID 0x3251) at B?:D0:F1
+ * that publishes one base register and four MEMn offset registers, encoding
+ * the physical address of the four iMCs' MMIO regions. Each iMC contains two
+ * channel-level PMON boxes at +0x22800 and +0x2A800.
+ */
+static int spr_imc_init(void)
+{
+    struct pci_dev *pdev = NULL;
+    int socket = 0;
+    int imc, ch;
+    u32 base_dword, mem_dword;
+    resource_size_t base, addr;
+
+    while ((pdev = pci_get_device(PCI_VENDOR_ID_INTEL,
+                                  SPR_IMC_PCI_DID, pdev)) != NULL) {
+        if (socket >= NUM_SOCKETS) {
+            pci_dev_put(pdev);
+            break;
+        }
+
+        if (pci_read_config_dword(pdev, SPR_IMC_MMIO_BASE_OFFSET,
+                                  &base_dword)) {
+            pr_err("[mttm] iMC: pci_read_config_dword(BASE) failed sock=%d\n",
+                   socket);
+            pci_dev_put(pdev);
+            spr_imc_unmap_all();
+            return -EIO;
+        }
+        base = ((resource_size_t)(base_dword & SPR_IMC_MMIO_BASE_MASK))
+               << SPR_IMC_MMIO_BASE_SHIFT;
+
+        for (imc = 0; imc < NUM_IMC_PER_SOCKET; imc++) {
+            int memn_off = SPR_IMC_MMIO_MEM0_OFFSET +
+                           imc * SPR_IMC_MMIO_MEM_STRIDE;
+            if (pci_read_config_dword(pdev, memn_off, &mem_dword)) {
+                pr_err("[mttm] iMC: pci_read_config_dword(MEM%d) failed sock=%d\n",
+                       imc, socket);
+                pci_dev_put(pdev);
+                spr_imc_unmap_all();
+                return -EIO;
+            }
+            addr = base | (((resource_size_t)(mem_dword & SPR_IMC_MMIO_MEM_MASK))
+                           << SPR_IMC_MMIO_MEM_SHIFT);
+
+            for (ch = 0; ch < NUM_CH_PER_IMC; ch++) {
+                resource_size_t ch_addr = addr + SPR_IMC_MMIO_CHN_OFFSET +
+                                          ch * SPR_IMC_MMIO_CHN_STRIDE;
+                spr_imc_mmio[socket][imc][ch] =
+                    ioremap(ch_addr, SPR_IMC_MMIO_SIZE);
+                if (!spr_imc_mmio[socket][imc][ch]) {
+                    pr_err("[mttm] iMC: ioremap failed sock=%d imc=%d ch=%d addr=%pa\n",
+                           socket, imc, ch, &ch_addr);
+                    pci_dev_put(pdev);
+                    spr_imc_unmap_all();
+                    return -ENOMEM;
+                }
+            }
+        }
+
+        /* keep the pdev alive for the lifetime of the mapping */
+        spr_imc_pdev[socket] = pci_dev_get(pdev);
+        socket++;
+    }
+
+    if (socket < NUM_SOCKETS) {
+        pr_err("[mttm] iMC: only %d/%d sockets found (DID 0x%x)\n",
+               socket, NUM_SOCKETS, SPR_IMC_PCI_DID);
+        spr_imc_unmap_all();
+        return -ENODEV;
+    }
+    return 0;
+}
+
+/*
+ * Program one (socket, iMC, channel) PMON box: freeze, reset, install events,
+ * unfreeze. Counter assignment matches the legacy [0]=read, [1]=write,
+ * [4]=clockticks layout used elsewhere in this file.
+ */
+static void spr_imc_program_box(int socket, int imc, int ch)
+{
+    void __iomem *base = spr_imc_mmio[socket][imc][ch];
+    if (!base)
+        return;
+
+    /* Freeze and reset counters */
+    writel(SPR_IMC_PMON_BOX_CTL_FRZ | SPR_IMC_PMON_BOX_CTL_RST_CTRS,
+           base + SPR_IMC_PMON_BOX_CTL);
+
+    writel(SPR_IMC_PMON_CTL_VAL(SPR_IMC_EVT_CAS_COUNT,
+                                 SPR_IMC_UMASK_CAS_RD),
+           base + SPR_IMC_PMON_CTL(0));
+    writel(SPR_IMC_PMON_CTL_VAL(SPR_IMC_EVT_CAS_COUNT,
+                                 SPR_IMC_UMASK_CAS_WR),
+           base + SPR_IMC_PMON_CTL(1));
+    writel(SPR_IMC_PMON_CTL_VAL(SPR_IMC_EVT_CLOCKTICKS, 0),
+           base + SPR_IMC_PMON_CTL(2));
+
+    /* Unfreeze */
+    writel(0, base + SPR_IMC_PMON_BOX_CTL);
+}
+
+/*
+ * Read a 48-bit IMC counter at the given offset. The counter spans two
+ * 32-bit dwords; readq isn't safe on all platforms for MMIO so we issue
+ * two readl's and stitch them together. Top 16 bits of the counter are
+ * undefined per the manual; we mask to 48 bits.
+ */
+static inline u64 spr_imc_read_ctr(void __iomem *base, unsigned int off)
+{
+    u32 lo = readl(base + off);
+    u32 hi = readl(base + off + 4);
+    return ((((u64)hi) << 32) | (u64)lo) & ((1ULL << 48) - 1);
+}
